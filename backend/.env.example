# =================================================================
# Tender AI Agent - Environment Configuration Template
# Copy this file to .env and configure your values.
# NEVER commit your actual .env file to version control!
# =================================================================

# 1. OpenAI API Key (Required for AI tender filtering and scoring)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# 2. OpenAI Model Selection
# 'gpt-4o-mini' is fast and cost-effective; 'gpt-4o' gives higher precision.
AI_MODEL=gpt-4o-mini

# 3. Products/Keywords your business supplies (comma-separated)
# Used by AI to evaluate relevance and match score against tender specs.
PRODUCT_KEYWORDS=mobile lighting tower,inflatable lighting tower,MST lighting,mobile service tower,inflatable light system,balloon light,portable lighting tower,LED tower light,floodlight tower,light mast,telescopic mast light,lighting tower system,mobile solar tower

# 4. Search keywords typed into GeM portal search box (comma-separated)
SEARCH_KEYWORDS=mobile light tower,inflatable light,MST light,lighting tower,balloon light,portable light tower,LED tower light

# 5. Scraper Settings
# MAX_PAGES: Maximum search result pages to scrape per keyword (1-5 recommended)
MAX_PAGES=3

# HEADLESS: 'false' opens a visible Chrome window (recommended to avoid bot blocks), 'true' runs silently
HEADLESS=false
